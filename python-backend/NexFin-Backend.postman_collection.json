{
  "info": {
    "name": "NexFin Backend",
    "description": "Tests the NexFin FastAPI backend directly (http://localhost:8000). Does not call the upstream Keycloak/core-api services except through the backend's own /auth and /accounts proxy routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "username", "value": "" },
    { "key": "password", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "account_id", "value": "6a61fde1c47905bfc3f19571" },
    { "key": "item_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "let jsonData;",
                  "try { jsonData = pm.response.json(); } catch (e) { jsonData = null; }",
                  "if (jsonData && jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "    console.log('access_token saved to collection variables');",
                  "} else {",
                  "    console.warn('access_token not found in login response');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "List Items",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/items/", "host": ["{{base_url}}"], "path": ["items", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test item\",\n  \"description\": \"Created from Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/items/", "host": ["{{base_url}}"], "path": ["items", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "let jsonData;",
                  "try { jsonData = pm.response.json(); } catch (e) { jsonData = null; }",
                  "if (jsonData && jsonData.id) {",
                  "    pm.collectionVariables.set('item_id', jsonData.id);",
                  "    console.log('item_id saved: ' + jsonData.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Item By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/items/{{item_id}}",
              "host": ["{{base_url}}"],
              "path": ["items", "{{item_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('id matches requested item_id', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('item_id')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Item By Id - Not Found",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/items/999999", "host": ["{{base_url}}"], "path": ["items", "999999"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 404', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "List Accounts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/accounts?type=domestic",
              "host": ["{{base_url}}"],
              "path": ["accounts"],
              "query": [{ "key": "type", "value": "domestic" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get Account By Id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/accounts/{{account_id}}",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{account_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get Balances",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/accounts/{{account_id}}/balances",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{account_id}}", "balances"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/accounts/{{account_id}}/transactions?pageIndex=0&pageSize=10",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{account_id}}", "transactions"],
              "query": [
                { "key": "pageIndex", "value": "0" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('pageSize honored', () => pm.expect(pm.response.json().Data.Transaction.length).to.be.at.most(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Accounts - Missing Auth Header",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/accounts", "host": ["{{base_url}}"], "path": ["accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 422', () => pm.response.to.have.status(422));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Notice",
      "item": [
        {
          "name": "Get Notice Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/me/notice", "host": ["{{base_url}}"], "path": ["me", "notice"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has acknowledged field', () => pm.expect(pm.response.json()).to.have.property('acknowledged'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Acknowledge Notice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/me/notice/ack", "host": ["{{base_url}}"], "path": ["me", "notice", "ack"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('acknowledged is true', () => pm.expect(pm.response.json().acknowledged).to.eql(true));",
                  "pm.test('acknowledged_at is set', () => pm.expect(pm.response.json().acknowledged_at).to.not.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Notice Status - Missing Auth Header",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/me/notice", "host": ["{{base_url}}"], "path": ["me", "notice"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 422', () => pm.response.to.have.status(422));"]
              }
            }
          ]
        },
        {
          "name": "Revoke Notice Acknowledgement",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/me/notice/ack", "host": ["{{base_url}}"], "path": ["me", "notice", "ack"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('acknowledged is false', () => pm.expect(pm.response.json().acknowledged).to.eql(false));",
                  "pm.test('acknowledged_at is null', () => pm.expect(pm.response.json().acknowledged_at).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke Notice Acknowledgement - Missing Auth Header",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/me/notice/ack", "host": ["{{base_url}}"], "path": ["me", "notice", "ack"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 422', () => pm.response.to.have.status(422));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "Sync Accounts",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/sync/accounts", "host": ["{{base_url}}"], "path": ["sync", "accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has accounts_synced and transactions_synced', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('accounts_synced');",
                  "    pm.expect(body).to.have.property('transactions_synced');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync Accounts - Missing Auth Header",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/sync/accounts", "host": ["{{base_url}}"], "path": ["sync", "accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 422', () => pm.response.to.have.status(422));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Analysis",
      "item": [
        {
          "name": "Monthly Spending",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/analysis/monthly-spending",
              "host": ["{{base_url}}"],
              "path": ["analysis", "monthly-spending"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "const body = pm.response.json();",
                  "if (body.length > 0) {",
                  "    pm.test('month entries have expected shape', () => {",
                  "        const entry = body[0];",
                  "        pm.expect(entry).to.have.property('month');",
                  "        pm.expect(entry).to.have.property('total_spend');",
                  "        pm.expect(entry).to.have.property('total_income');",
                  "        pm.expect(entry).to.have.property('pending_spend');",
                  "        pm.expect(entry).to.have.property('pending_income');",
                  "        pm.expect(entry).to.have.property('by_category');",
                  "        pm.expect(entry).to.have.property('by_merchant');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Monthly Spending - Missing Auth Header",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/analysis/monthly-spending",
              "host": ["{{base_url}}"],
              "path": ["analysis", "monthly-spending"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 422', () => pm.response.to.have.status(422));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
